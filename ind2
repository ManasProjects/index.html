<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fleet Paper Tracker — Gupta Stone Mines</title>
<style>
  :root{
    --bg: #0a0d12;
    --panel: #11161e;
    --panel-2: #161c26;
    --border: #222a37;
    --border-soft: #1a212c;
    --ink: #e9eef5;
    --muted: #7c899d;
    --muted-2: #566275;
    --amber: #f5a524;
    --amber-dim: rgba(245,165,36,.13);
    --red: #f0454b;
    --red-dim: rgba(240,69,75,.13);
    --yellow: #e8d24a;
    --yellow-dim: rgba(232,210,74,.11);
    --green: #29c46b;
    --green-dim: rgba(41,196,107,.11);
    --blue: #5b8cff;
    --mono: ui-monospace,'SFMono-Regular','DM Mono',Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(1100px 560px at 88% -8%, rgba(91,140,255,.08), transparent 58%),
      radial-gradient(900px 480px at -8% 8%, rgba(245,165,36,.055), transparent 55%),
      var(--bg);
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1280px;margin:0 auto;padding:22px 18px 90px;}

  #errBanner{display:none;position:sticky;top:0;z-index:99;background:#2a1416;border:1px solid rgba(240,69,75,.4);
    color:#ffb3b6;padding:10px 14px;border-radius:10px;font-size:12.5px;margin-bottom:14px;font-family:var(--mono);}

  header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:18px;
    padding-bottom:18px;border-bottom:1px solid var(--border-soft);}
  .brand{display:flex;align-items:center;gap:13px;}
  .brand-mark{
    width:44px;height:44px;border-radius:11px;
    background:linear-gradient(150deg,#1c2636,#0d131c);
    border:1px solid var(--border);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--mono);font-weight:700;color:var(--amber);font-size:17px;letter-spacing:-.5px;
    flex-shrink:0;
  }
  h1{font-size:19.5px;margin:0;letter-spacing:.1px;font-weight:650;}
  .sub{color:var(--muted);font-size:12.5px;margin-top:3px;}
  .clock{text-align:right;font-family:var(--mono);font-size:12px;color:var(--muted);}
  .clock .today{color:var(--ink);font-weight:600;font-size:13px;}
  .live-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--green);margin-right:7px;
    box-shadow:0 0 0 0 rgba(41,196,107,.6);animation:pulse 2.2s infinite;}
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(41,196,107,.5);}
    70%{box-shadow:0 0 0 6px rgba(41,196,107,0);}
    100%{box-shadow:0 0 0 0 rgba(41,196,107,0);}
  }

  /* Tabs */
  .tabs{display:flex;gap:6px;margin-bottom:20px;background:var(--panel);border:1px solid var(--border);
    border-radius:11px;padding:4px;width:fit-content;}
  .tab{padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;user-select:none;transition:.12s;}
  .tab.active{background:var(--blue);color:#fff;}
  .tab:hover:not(.active){color:var(--ink);}

  .view{display:none;}
  .view.active{display:block;}

  .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px;}
  .kpi{
    background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:15px 17px;
    position:relative;overflow:hidden;
  }
  .kpi::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--muted-2);}
  .kpi .n{font-family:var(--mono);font-size:27px;font-weight:700;line-height:1;}
  .kpi .l{color:var(--muted);font-size:11px;margin-top:7px;text-transform:uppercase;letter-spacing:.07em;}
  .kpi.expired::before{background:var(--red);} .kpi.expired .n{color:var(--red);}
  .kpi.critical::before{background:var(--amber);} .kpi.critical .n{color:var(--amber);}
  .kpi.warning::before{background:var(--yellow);} .kpi.warning .n{color:var(--yellow);}
  .kpi.total::before{background:var(--blue);} .kpi.total .n{color:var(--blue);}

  .section-title{display:flex;align-items:center;gap:9px;margin:28px 0 11px;font-size:12.5px;color:var(--muted);
    text-transform:uppercase;letter-spacing:.08em;font-weight:650;}
  .section-title .dot{width:7px;height:7px;border-radius:50%;background:var(--red);}
  .section-title .cnt{background:var(--panel-2);border:1px solid var(--border);border-radius:20px;padding:1px 9px;color:var(--ink);font-family:var(--mono);font-size:11.5px;}

  .alert-list{display:flex;flex-direction:column;gap:7px;}
  .alert{
    display:flex;align-items:center;gap:12px;background:var(--panel);border:1px solid var(--border);
    border-left:3px solid var(--red);border-radius:10px;padding:11px 14px;
    cursor:pointer; transition:transform .12s ease, background .12s ease;
  }
  .alert:hover{background:var(--panel-2);transform:translateX(2px);}
  .alert.amber{border-left-color:var(--amber);}
  .alert.ok{border-left-color:var(--green);}
  .alert .badge{
    font-family:var(--mono);font-size:10px;font-weight:700;padding:3px 8px;border-radius:6px;
    background:var(--red-dim);color:#ff9195;white-space:nowrap;letter-spacing:.03em;
  }
  .alert.amber .badge{background:var(--amber-dim);color:var(--amber);}
  .alert.ok .badge{background:var(--green-dim);color:var(--green);}
  .alert .veh{font-weight:650;font-size:13.5px;min-width:132px;font-family:var(--mono);}
  .alert .doc{color:var(--muted);font-size:12.5px;flex:1;}
  .alert .doc b{color:var(--ink);font-weight:600;}
  .alert .days{font-family:var(--mono);font-size:12px;color:var(--muted);white-space:nowrap;}
  .empty-state{color:var(--muted);font-size:13px;padding:18px;text-align:center;background:var(--panel);border:1px dashed var(--border);border-radius:10px;}
  .empty-state b{color:var(--green);}

  .controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:26px 0 12px;}
  input[type=text]{
    background:var(--panel);border:1px solid var(--border);color:var(--ink);border-radius:9px;
    padding:9px 12px;font-size:13px;width:230px;outline:none;
  }
  input[type=text]:focus{border-color:var(--blue);}
  .chip{
    background:var(--panel);border:1px solid var(--border);color:var(--muted);border-radius:20px;
    padding:6px 13px;font-size:12px;cursor:pointer;user-select:none;transition:.12s;white-space:nowrap;
  }
  .chip.active{background:var(--blue);border-color:var(--blue);color:#fff;}
  .chip:hover{border-color:var(--blue);}
  .spacer{flex:1;}
  .tax-ref{font-family:var(--mono);font-size:11px;color:var(--muted);display:flex;gap:14px;flex-wrap:wrap;
    background:var(--panel);border:1px solid var(--border);border-radius:9px;padding:8px 13px;}
  .tax-ref b{color:var(--amber);font-weight:700;}

  .table-scroll{overflow-x:auto;border:1px solid var(--border);border-radius:12px;background:var(--panel);}
  table{border-collapse:collapse;width:100%;min-width:920px;}
  thead th{
    position:sticky;top:0;background:var(--panel-2);z-index:2;
    text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);
    padding:12px 12px;border-bottom:1px solid var(--border);font-weight:650;
  }
  tbody td{padding:9px 10px;border-bottom:1px solid var(--border-soft);font-size:13px;vertical-align:middle;}
  tbody tr:last-child td{border-bottom:none;}
  tbody tr:hover{background:rgba(255,255,255,.015);}
  .vehcell .vno{font-family:var(--mono);font-weight:650;font-size:12.6px;}
  .vehcell .vname{color:var(--muted);font-size:11.3px;margin-top:2px;}
  .cell-doc{cursor:pointer;border-radius:8px;padding:7px 9px;min-width:116px;transition:filter .1s;}
  .cell-doc:hover{filter:brightness(1.2);}
  .cell-doc .date{font-family:var(--mono);font-size:11.8px;}
  .cell-doc .days{font-size:10.8px;margin-top:2px;opacity:.9;}
  .st-expired{background:var(--red-dim);color:#ff9195;}
  .st-critical{background:var(--amber-dim);color:#ffcc80;}
  .st-warning{background:var(--yellow-dim);color:#eee08c;}
  .st-ok{background:var(--green-dim);color:#8fe8ab;}
  .st-grace{background:rgba(245,165,36,.19);color:#ffcc80;}
  .st-none{background:rgba(255,255,255,.03);color:var(--muted-2);}
  .st-skip{background:rgba(255,255,255,.02);color:#4c5666;font-style:italic;}

  /* Monthly view */
  .month-chips{display:flex;gap:7px;overflow-x:auto;padding-bottom:8px;margin-bottom:6px;}
  .month-chip{
    flex-shrink:0;background:var(--panel);border:1px solid var(--border);color:var(--muted);
    border-radius:10px;padding:9px 15px;font-size:12.5px;font-weight:650;cursor:pointer;text-align:center;
    font-family:var(--mono);transition:.12s;position:relative;
  }
  .month-chip .cnt{display:block;font-size:16px;margin-top:3px;color:var(--ink);}
  .month-chip.active{background:var(--blue);border-color:var(--blue);color:#fff;}
  .month-chip.active .cnt{color:#fff;}
  .month-chip.has-urgent:not(.active)::after{
    content:'';position:absolute;top:6px;right:6px;width:6px;height:6px;border-radius:50%;background:var(--red);
  }
  .manual-jump{display:flex;gap:8px;align-items:center;margin:14px 0 22px;font-size:12.5px;color:var(--muted);flex-wrap:wrap;}
  .manual-jump select{
    background:var(--panel);border:1px solid var(--border);color:var(--ink);border-radius:8px;
    padding:7px 10px;font-size:13px;outline:none;font-family:inherit;
  }
  .month-summary{font-size:13.5px;color:var(--muted);margin:4px 0 16px;}
  .month-summary b{color:var(--ink);}
  .month-list{display:flex;flex-direction:column;gap:7px;}
  .month-row{
    display:flex;align-items:center;gap:14px;background:var(--panel);border:1px solid var(--border);
    border-radius:10px;padding:12px 15px;cursor:pointer;transition:.12s;
  }
  .month-row:hover{background:var(--panel-2);}
  .month-row .datebox{
    font-family:var(--mono);text-align:center;background:var(--panel-2);border:1px solid var(--border);
    border-radius:8px;padding:6px 10px;min-width:44px;flex-shrink:0;
  }
  .month-row .datebox .dnum{font-size:17px;font-weight:700;line-height:1;}
  .month-row .datebox .dwd{font-size:9.5px;color:var(--muted);text-transform:uppercase;margin-top:2px;}
  .month-row .info{flex:1;min-width:0;}
  .month-row .info .v{font-family:var(--mono);font-weight:650;font-size:13px;}
  .month-row .info .n{color:var(--muted);font-size:12px;margin-top:1px;}
  .month-row .docpill{
    font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;white-space:nowrap;
  }
  .month-row .statuspill{font-family:var(--mono);font-size:11.5px;color:var(--muted);white-space:nowrap;min-width:90px;text-align:right;}

  footer{margin-top:36px;color:var(--muted-2);font-size:11.3px;text-align:center;font-family:var(--mono);line-height:1.7;}
  footer .tag{display:inline-block;background:var(--panel);border:1px solid var(--border);border-radius:20px;padding:3px 10px;margin-top:6px;}

  .overlay{position:fixed;inset:0;background:rgba(3,6,10,.65);backdrop-filter:blur(2px);display:none;align-items:center;justify-content:center;z-index:50;padding:16px;}
  .overlay.show{display:flex;}
  .modal{background:var(--panel);border:1px solid var(--border);border-radius:14px;width:340px;max-width:100%;padding:20px;position:relative;}
  .modal h3{margin:0 0 4px;font-size:15px;font-family:var(--mono);}
  .modal .m-sub{color:var(--muted);font-size:12px;margin-bottom:14px;}
  .modal label{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px;margin-top:12px;}
  .modal input[type=date]{
    width:100%;background:var(--panel-2);border:1px solid var(--border);color:var(--ink);
    border-radius:8px;padding:9px 10px;font-family:var(--mono);font-size:13px;outline:none;
    color-scheme: dark;
  }
  .modal .row{display:flex;gap:10px;}
  .modal .row > div{flex:1;}
  .modal .persist-note{font-size:10.7px;color:var(--muted-2);margin-top:12px;font-family:var(--mono);}
  .modal .actions{display:flex;gap:8px;margin-top:18px;}
  .btn{flex:1;padding:9px 10px;border-radius:8px;border:1px solid var(--border);background:var(--panel-2);color:var(--ink);
    font-size:13px;cursor:pointer;font-weight:600;}
  .btn.primary{background:var(--blue);border-color:var(--blue);color:#fff;}
  .btn.danger{background:transparent;border-color:rgba(240,69,75,.4);color:var(--red);}
  .btn:hover{filter:brightness(1.12);}
  .close-x{position:absolute;top:14px;right:16px;cursor:pointer;color:var(--muted);font-size:18px;line-height:1;}

  @media(max-width:640px){
    .kpis{grid-template-columns:repeat(2,1fr);}
    .clock{text-align:left;}
    header{flex-direction:column;}
    .month-row{flex-wrap:wrap;}
    .month-row .statuspill{text-align:left;}
  }
</style>
</head>
<body>
<div class="wrap">

  <div id="errBanner"></div>

  <header>
    <div class="brand">
      <div class="brand-mark">GS</div>
      <div>
        <h1>Fleet Paper Tracker</h1>
        <div class="sub">Gupta Stone Mines &middot; Insurance &middot; Permit &middot; Pollution &middot; Fitness &middot; Tax</div>
      </div>
    </div>
    <div class="clock">
      <div class="today"><span class="live-dot"></span><span id="todayStr">—</span></div>
      <div id="tickStr" style="margin-top:3px;">initialising…</div>
    </div>
  </header>

  <div class="tabs">
    <div class="tab active" data-tab="overview">Overview</div>
    <div class="tab" data-tab="monthly">Month-wise Planner</div>
  </div>

  <!-- OVERVIEW -->
  <div class="view active" id="view-overview">
    <div class="kpis">
      <div class="kpi expired"><div class="n" id="kpiExpired">0</div><div class="l">Expired</div></div>
      <div class="kpi critical"><div class="n" id="kpiCritical">0</div><div class="l">Due &le; 7 days</div></div>
      <div class="kpi warning"><div class="n" id="kpiWarning">0</div><div class="l">Due &le; 30 days</div></div>
      <div class="kpi total"><div class="n" id="kpiTotal">0</div><div class="l">Vehicles Tracked</div></div>
    </div>

    <div class="section-title"><span class="dot"></span> Needs Action Now <span class="cnt" id="alertCount">0</span></div>
    <div class="alert-list" id="alertList"></div>

    <div class="controls">
      <input type="text" id="search" placeholder="Search vehicle no. or name…">
      <div class="chip active" data-filter="all">All vehicles</div>
      <div class="chip" data-filter="urgent">Expired / urgent only</div>
      <div class="spacer"></div>
      <div class="tax-ref">Tax rate — <b>10 tyre</b> ₹5,800 &nbsp;/&nbsp; <b>12 tyre</b> ₹7,200 &nbsp;/&nbsp; <b>14 tyre</b> ₹8,600 &nbsp;&middot;&nbsp; 15-day grace after tax expiry</div>
    </div>

    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Vehicle</th>
            <th>Insurance</th>
            <th>Permit</th>
            <th>Pollution</th>
            <th>Fitness</th>
            <th>Tax</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>

  <!-- MONTHLY -->
  <div class="view" id="view-monthly">
    <div class="section-title"><span class="dot" style="background:var(--blue)"></span> Pick a month</div>
    <div class="month-chips" id="monthChips"></div>
    <div class="manual-jump">
      Jump to any month:
      <select id="jumpMonth"></select>
      <select id="jumpYear"></select>
    </div>
    <div class="month-summary" id="monthSummary"></div>
    <div class="month-list" id="monthList"></div>
  </div>

  <footer>
    Tap any coloured cell or list row to update its renewal date after you've paid/renewed.<br>
    <span class="tag" id="persistTag">checking save mode…</span>
  </footer>
</div>

<div class="overlay" id="overlay">
  <div class="modal">
    <span class="close-x" id="modalClose">✕</span>
    <h3 id="mTitle">Update date</h3>
    <div class="m-sub" id="mSub"></div>
    <div class="row">
      <div>
        <label>Valid from</label>
        <input type="date" id="mFrom">
      </div>
      <div>
        <label>Valid to</label>
        <input type="date" id="mTo">
      </div>
    </div>
    <div class="persist-note" id="persistNote"></div>
    <div class="actions">
      <button class="btn danger" id="mReset">Reset</button>
      <button class="btn primary" id="mSave">Save</button>
    </div>
  </div>
</div>

<script>
window.addEventListener('error', function(e){
  try{
    var b = document.getElementById('errBanner');
    if(b){
      b.style.display='block';
      b.textContent = 'Something went wrong: ' + (e.message || 'unknown error') + '. Your data is safe — try reloading the page.';
    }
  }catch(_e){}
