  var today = todayMidnight();
  var daysLeft = daysBetween(today, to);

  if(docKey === 'tax'){
    if(daysLeft >= 0){
      if(daysLeft <= CRITICAL_DAYS) return {status:'critical', label:'Due in '+daysLeft+'d', daysLeft:daysLeft};
