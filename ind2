    DOCS.forEach(function(dc){
      if(v.skip_docs && v.skip_docs[dc.key]) return;
      var d = getDocData(v, dc.key);
      if(!d || !d.to) return;
      var to = parseISO(d.to);
      if(!to) return;
      var c = classify(v, dc.key);
      out.push({v:v, dc:dc, to:to, c:c});
    });
  });
  return out;
}

/* ================= OVERVIEW RENDER ================= */
function renderOverview(){
  var today = todayMidnight();
  document.getElementById('todayStr').textContent = today.toLocaleDateString('en-IN',{weekday:'long', day:'2-digit', month:'long', year:'numeric'});
  document.getElementById('tickStr').textContent = 'live · ' + new Date().toLocaleTimeString('en-IN');

  var filterEl = document.querySelector('#view-overview .chip.active');
  var filter = filterEl ? filterEl.dataset.filter : 'all';
  var q = document.getElementById('search').value.trim().toLowerCase();

  var expiredCt=0, criticalCt=0, warningCt=0;
  var alerts = [];

  DATA.forEach(function(v){
    DOCS.forEach(function(dc){
      var c = classify(v, dc.key);
      if(c.status==='expired') expiredCt++;
      else if(c.status==='critical' || c.status==='grace') criticalCt++;
      else if(c.status==='warning') warningCt++;

      if(c.status==='expired' || c.status==='critical' || c.status==='grace'){
        var sortKey = c.status==='expired' ? -99999 + (c.daysLeft||0) : (c.daysLeft!==null?c.daysLeft:999);
        alerts.push({v:v, dc:dc, c:c, sortKey:sortKey});
      }
    });
  });

  document.getElementById('kpiExpired').textContent = expiredCt;
  document.getElementById('kpiCritical').textContent = criticalCt;
  document.getElementById('kpiWarning').textContent = warningCt;
  document.getElementById('kpiTotal').textContent = DATA.length;

  alerts.sort(function(a,b){ return a.sortKey-b.sortKey; });
  document.getElementById('alertCount').textContent = alerts.length;
  var alertList = document.getElementById('alertList');
  alertList.innerHTML = '';
  if(alerts.length===0){
    alertList.innerHTML = '<div class="empty-state"><b>All clear.</b> Nothing urgent right now — every document is within safe range.</div>';
  } else {
    alerts.slice(0,25).forEach(function(a){
      var div = document.createElement('div');
      div.className = 'alert' + (a.c.status!=='expired' ? ' amber' : '');
      var badgeTxt = a.c.status==='expired' ? 'EXPIRED' : (a.c.status==='grace' ? 'GRACE' : 'URGENT');
      div.innerHTML =
        '<span class="badge">'+badgeTxt+'</span>'+
        '<span class="veh">'+a.v.vehicle_no+'</span>'+
        '<span class="doc"><b>'+a.dc.label+'</b> — '+a.v.name+'</span>'+
        '<span class="days">'+a.c.label+'</span>';
      div.addEventListener('click', function(){ openModal(a.v, a.dc.key); });
      alertList.appendChild(div);
    });
  }

  var rows = DATA.slice();
  if(q){
    rows = rows.filter(function(v){
      return v.vehicle_no.toLowerCase().indexOf(q)>-1 || (v.name||'').toLowerCase().indexOf(q)>-1;
    });
  }
  if(filter==='urgent'){
    rows = rows.filter(function(v){
      return DOCS.some(function(dc){
        var s = classify(v,dc.key).status;
        return s==='expired' || s==='critical' || s==='grace';
      });
    });
  }
  rows.sort(function(a,b){
    function worst(v){
      var vals = DOCS.map(function(dc){
        var c = classify(v, dc.key);
        if(c.status==='expired') return -99999+(c.daysLeft||0);
        if(c.status==='none' || c.status==='skip') return 100000;
        return c.daysLeft!==null? c.daysLeft:100000;
      });
      return Math.min.apply(null, vals);
    }
    return worst(a)-worst(b);
  });

  var tbody = document.getElementById('tbody');
  tbody.innerHTML = '';
  rows.forEach(function(v){
    var tr = document.createElement('tr');
    var html = '<td class="vehcell"><div class="vno">'+v.vehicle_no+'</div><div class="vname">'+v.name+'</div></td>';
    DOCS.forEach(function(dc){
      var c = classify(v, dc.key);
      var d = getDocData(v, dc.key);
      var dateTxt = (d && d.to) ? displayDate(d.to) : '—';
      var extra = '';
      if(dc.key==='tax'){
        var amt = taxAmount(v);
        if(amt) extra = '<div class="days">₹'+amt.toLocaleString('en-IN')+' · '+v.tyre_no+' tyre</div>';
      }
      html += '<td><div class="cell-doc '+statusClass(c.status)+'" data-v="'+v.vehicle_no+'" data-doc="'+dc.key+'">'+
        '<div class="date">'+dateTxt+'</div>'+
        '<div class="days">'+c.label+'</div>'+extra+
        '</div></td>';
    });
    tr.innerHTML = html;
    tbody.appendChild(tr);
  });

  Array.prototype.forEach.call(tbody.querySelectorAll('.cell-doc'), function(el){
    el.addEventListener('click', function(){
      var vno = el.getAttribute('data-v'), doc = el.getAttribute('data-doc');
      var v = DATA.filter(function(x){ return x.vehicle_no===vno; })[0];
      if(v) openModal(v, doc);
    });
  });
}

/* ================= MONTHLY RENDER ================= */
function buildMonthChips(){
  var container = document.getElementById('monthChips');
  container.innerHTML = '';
  var today = todayMidnight();
  var entries = allEntries();

  for(var i=0;i<12;i++){
    var y = today.getFullYear();
    var m = today.getMonth()+i;
    y += Math.floor(m/12);
    m = m%12;
    var cnt = entries.filter(function(e){ return e.to.getFullYear()===y && e.to.getMonth()===m; }).length;
    var hasUrgent = entries.some(function(e){
      return e.to.getFullYear()===y && e.to.getMonth()===m && (e.c.status==='expired'||e.c.status==='critical'||e.c.status==='grace');
    });
    var chip = document.createElement('div');
    chip.className = 'month-chip' + (hasUrgent?' has-urgent':'');
    chip.dataset.y = y; chip.dataset.m = m;
    chip.innerHTML = MONTH_SHORT[m]+" '"+String(y).slice(2)+'<span class="cnt">'+cnt+'</span>';
    chip.addEventListener('click', function(){ selectMonth(parseInt(this.dataset.y,10), parseInt(this.dataset.m,10)); });
    container.appendChild(chip);
  }
  if(!selectedMonth){
    selectedMonth = {year: today.getFullYear(), month: today.getMonth()};
  }
}

function buildJumpSelects(){
  var mSel = document.getElementById('jumpMonth');
  var ySel = document.getElementById('jumpYear');
  if(mSel.options.length===0){
    MONTH_NAMES.forEach(function(name,i){
      var o = document.createElement('option');
      o.value=i; o.textContent=name;
      mSel.appendChild(o);
    });
    mSel.addEventListener('change', function(){
      selectMonth(parseInt(ySel.value,10), parseInt(mSel.value,10));
    });
  }
  var entries = allEntries();
  var years = {};
  var today = todayMidnight();
  years[today.getFullYear()] = true;
  entries.forEach(function(e){ years[e.to.getFullYear()] = true; });
  var yearList = Object.keys(years).map(Number).sort(function(a,b){return a-b;});
  var existing = Array.prototype.map.call(ySel.options, function(o){ return o.value; }).join(',');
  var wanted = yearList.join(',');
  if(existing !== wanted){
    ySel.innerHTML = '';
    yearList.forEach(function(y){
      var o = document.createElement('option');
      o.value=y; o.textContent=y;
      ySel.appendChild(o);
    });
    ySel.addEventListener('change', function(){
      selectMonth(parseInt(ySel.value,10), parseInt(mSel.value,10));
    });
  }
}

function selectMonth(y, m){
  selectedMonth = {year:y, month:m};
  renderMonthly();
}

function renderMonthly(){
  buildMonthChips();
  buildJumpSelects();

  if(!selectedMonth){
    var t = todayMidnight();
    selectedMonth = {year:t.getFullYear(), month:t.getMonth()};
  }

  Array.prototype.forEach.call(document.querySelectorAll('.month-chip'), function(chip){
    var isActive = parseInt(chip.dataset.y,10)===selectedMonth.year && parseInt(chip.dataset.m,10)===selectedMonth.month;
    chip.classList.toggle('active', isActive);
  });
  document.getElementById('jumpMonth').value = selectedMonth.month;
  document.getElementById('jumpYear').value = selectedMonth.year;

  var entries = allEntries().filter(function(e){
    return e.to.getFullYear()===selectedMonth.year && e.to.getMonth()===selectedMonth.month;
  });
  entries.sort(function(a,b){ return a.to-b.to; });

  var expiredN = entries.filter(function(e){return e.c.status==='expired';}).length;
  var urgentN = entries.filter(function(e){return e.c.status==='critical'||e.c.status==='grace';}).length;

  var summary = document.getElementById('monthSummary');
  if(entries.length===0){
    summary.innerHTML = 'No documents scheduled to expire in <b>'+MONTH_NAMES[selectedMonth.month]+' '+selectedMonth.year+'</b>.';
  } else {
    summary.innerHTML = '<b>'+entries.length+'</b> item(s) expiring in <b>'+MONTH_NAMES[selectedMonth.month]+' '+selectedMonth.year+'</b>'
      + (expiredN? ' &middot; <b style="color:var(--red)">'+expiredN+' already expired</b>':'')
      + (urgentN? ' &middot; <b style="color:var(--amber)">'+urgentN+' due very soon</b>':'');
  }

  var list = document.getElementById('monthList');
  list.innerHTML = '';
  if(entries.length===0){
    list.innerHTML = '<div class="empty-state">Nothing due this month. Try another month above.</div>';
    return;
  }
  entries.forEach(function(e){
    var row = document.createElement('div');
    row.className = 'month-row';
    var amt = e.dc.key==='tax' ? taxAmount(e.v) : null;
    row.innerHTML =
      '<div class="datebox"><div class="dnum">'+pad2(e.to.getDate())+'</div><div class="dwd">'+WD_SHORT[e.to.getDay()]+'</div></div>'+
      '<div class="info"><div class="v">'+e.v.vehicle_no+'</div><div class="n">'+e.v.name+(amt?(' · ₹'+amt.toLocaleString('en-IN')+' ('+e.v.tyre_no+' tyre)'):'')+'</div></div>'+
      '<span class="docpill" style="background:'+e.dc.color+'22;color:'+e.dc.color+'">'+e.dc.label+'</span>'+
      '<span class="statuspill '+statusClass(e.c.status)+'" style="padding:5px 10px;border-radius:8px;">'+e.c.label+'</span>';
    row.addEventListener('click', function(){ openModal(e.v, e.dc.key); });
    list.appendChild(row);
  });
}

/* ================= MODAL ================= */
function openModal(v, docKey){
  currentEdit = {vno:v.vehicle_no, doc:docKey};
  var dc = DOCS.filter(function(d){ return d.key===docKey; })[0];
  document.getElementById('mTitle').textContent = v.vehicle_no+' — '+dc.label;
  var amt = docKey==='tax' ? taxAmount(v) : null;
  document.getElementById('mSub').textContent = v.name + (amt ? (' · ₹'+amt+' ('+v.tyre_no+' tyre)') : '');
  var d = getDocData(v, docKey) || {};
  document.getElementById('mFrom').value = d.from || '';
  document.getElementById('mTo').value = d.to || '';
  document.getElementById('overlay').classList.add('show');
}
function closeModal(){
  document.getElementById('overlay').classList.remove('show');
  currentEdit = null;
}
document.getElementById('modalClose').addEventListener('click', closeModal);
document.getElementById('overlay').addEventListener('click', function(e){ if(e.target.id==='overlay') closeModal(); });

document.getElementById('mSave').addEventListener('click', function(){
  if(!currentEdit) return;
  var from = document.getElementById('mFrom').value || null;
  var to = document.getElementById('mTo').value || null;
  overrides[ovKey(currentEdit.vno, currentEdit.doc)] = {from:from, to:to};
  saveOverrides().then(function(){
    closeModal();
    renderAll();
  });
});
document.getElementById('mReset').addEventListener('click', function(){
  if(!currentEdit) return;
  delete overrides[ovKey(currentEdit.vno, currentEdit.doc)];
  saveOverrides().then(function(){
    closeModal();
    renderAll();
  });
});

/* ================= WIRING ================= */
function renderAll(){
  try{
    renderOverview();
    renderMonthly();
  }catch(err){
    var b = document.getElementById('errBanner');
    if(b){
      b.style.display='block';
      b.textContent = 'Render issue: ' + err.message + '. Try reloading the page.';
    }
    console.error(err);
  }
}

document.getElementById('search').addEventListener('input', renderOverview);
Array.prototype.forEach.call(document.querySelectorAll('#view-overview .chip'), function(chip){
  chip.addEventListener('click', function(){
    Array.prototype.forEach.call(document.querySelectorAll('#view-overview .chip'), function(c){ c.classList.remove('active'); });
    chip.classList.add('active');
    renderOverview();
  });
});
Array.prototype.forEach.call(document.querySelectorAll('.tab'), function(tab){
  tab.addEventListener('click', function(){
    Array.prototype.forEach.call(document.querySelectorAll('.tab'), function(t){ t.classList.remove('active'); });
    Array.prototype.forEach.call(document.querySelectorAll('.view'), function(v){ v.classList.remove('active'); });
    tab.classList.add('active');
    document.getElementById('view-'+tab.dataset.tab).classList.add('active');
    activeTab = tab.dataset.tab;
    if(activeTab==='monthly') renderMonthly();
  });
});

function init(){
  detectStorage();
  loadOverrides().then(function(){
    renderAll();
    setInterval(renderAll, 60*1000);
  }).catch(function(err){
    console.error(err);
    renderAll();
    setInterval(renderAll, 60*1000);
  });
}

if(document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
</script>
